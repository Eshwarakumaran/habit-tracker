# Auto detect text files and normalize line endings to LF
* text=auto

# JavaScript files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf

# CSS files
*.css text eol=lf
*.scss text eol=lf

# Markdown files
*.md text eol=lf

# Shell scripts
*.sh text eol=lf eol=crlf

# Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary

# Archives (binary)
*.zip binary
*.tar binary
*.gz binary
